#!/usr/bin/env bash
#
# Detect JS package manager and run watcher
#

PREFIX=""

if [ -f vendor/bin/sail ]; then
    echo 'sail detected'
    PREFIX="vendor/bin/sail"
fi

run() {
    echo "Running $*"
    exec "$@"
}

if [ -f yarn.lock ]; then
    run $PREFIX yarn dev "$@"
elif [ -f vite.config.js ]; then
    run $PREFIX npm run dev "$@"
elif [ -f package-lock.json ]; then
    run $PREFIX npm run watch "$@"
elif [ -f pnpm-lock.yaml ]; then
    run $PREFIX pnpm run watch "$@"
else
    echo 'Node package not detected'
fi
