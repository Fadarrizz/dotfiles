#!/usr/bin/env bash
set -euo pipefail

# Requirements
if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf is not installed or not in PATH."
  echo "Install (brew): brew install fzf"
  exit 1
fi

TEMPLATE="$HOME/.config/kitty/sessions/template.kitty-session"

if [[ ! -f "$TEMPLATE" ]]; then
  echo "Session template not found: $TEMPLATE"
  exit 1
fi

if [[ $# -eq 1 ]]; then
    SELECTED=$1
else
    # Depth = n + 1 since .git is one level deeper than project root
    items="$(find "$HOME/projects" "$HOME/work" -maxdepth 3 -name ".git" -type d | sed 's|/.git$||')"
    SELECTED=$(echo "$items" | fzf)
fi

if [[ -z "$SELECTED" ]]; then
    exit 0
fi

SELECTED_NAME=$(basename "$SELECTED" | tr . _)
SESSION_FILE="/tmp/${SELECTED_NAME}.kitty-session"

# Store temporary session file.
# This is needed because `goto_session` needs a unique file 
# path per project to identify with OS window to switch to.
sed \
  -e "s|{{PATH}}|$SELECTED|g" \
  -e "s|{{NAME}}|$SELECTED_NAME|g" \
  "$TEMPLATE" > "$SESSION_FILE"

# Switch to (or load) the session
SOCKET=$(ls /tmp/kitty-* 2>/dev/null | head -1)
if [[ -n "$SOCKET" ]]; then
    kitten @ --to "unix:$SOCKET" action goto_session "$SESSION_FILE"
else
    kitty --session "$SESSION_FILE" &
fi
